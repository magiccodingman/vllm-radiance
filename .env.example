# Copy to .env and adjust for the host. .env is intentionally gitignored and
# excluded from Docker image builds.
IMAGE=magiccodingman/vllm-radiance:latest
MODELS=./models
VLLM_CACHE=./vllm-cache
MODEL_PATH=/models/model
SERVED_MODEL_NAME=radiance-model
HIP_VISIBLE_DEVICES=0,1
TP=2
PORT=8000

# Balanced non-speculative starting envelope. MAX_NUM_SEQS is an admission
# ceiling; use the measured capacity table in README when every request may
# approach full length or a drafter is also loaded.
GPU_UTIL=0.85
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=4096
WEIGHT_QUANTIZATION=fp8

# Optional Qwen in-checkpoint MTP with R4D draft attention. Leave both unset for
# the correctness-qualified non-spec default. Uncomment both for the measured
# fast-MTP path; num_speculative_tokens is a ceiling under dynamic drafting.
# RADIANCE_SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":8,"attention_backend":"R4D","disable_padded_drafter_batch":true}'
# RADIANCE_FAST_DRAFT=1

# Alternative experimental DFlash2/V2 profile. Do not combine this with the MTP
# block above. Download magiccodingman/Qwen3.8-27B-heretic-ara-DFlash2-fp8
# beneath MODELS; the drafter path below is inside that mount. Change the active
# MAX_MODEL_LEN above to 8192. This reproduces the measured dual-R9700 K7 lane;
# strict cross-mode equivalence is not qualified.
# PREFIX_CACHING_FLAG=--no-enable-prefix-caching
# MAMBA_CACHE_MODE=none
# VLLM_USE_V2_MODEL_RUNNER=1
# RADIANCE_COMPILATION_CONFIG='{"cudagraph_mode":"PIECEWISE"}'
# RADIANCE_SPECULATIVE_CONFIG='{"method":"dflash","model":"/models/Qwen3.8-27B-heretic-ara-DFlash2-fp8-magiccodingman","num_speculative_tokens":7,"draft_tensor_parallel_size":2,"attention_backend":"TRITON_ATTN","max_model_len":8192}'
