# Copy to .env and adjust for the host. .env is intentionally gitignored and
# excluded from Docker image builds.
IMAGE=magiccodingman/vllm-radiance:latest
MODELS=./models
VLLM_CACHE=./vllm-cache
MODEL_PATH=/models/model
SERVED_MODEL_NAME=radiance-model
GENERATION_CONFIG=auto
DEFAULT_REASONING_EFFORT=xhigh
HIP_VISIBLE_DEVICES=0,1
TP=2
PORT=8000

# Balanced non-speculative starting envelope. MAX_NUM_SEQS is an admission
# ceiling; use the measured capacity table in README when every request may
# approach full length or a drafter is also loaded.
GPU_UTIL=0.85
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=4096
WEIGHT_QUANTIZATION=fp8

# Quark OCP MXFP4/W4A8 target. This is an alternative target-weight format,
# not an extra mode layered onto an FP8 checkpoint. Point MODEL_PATH at a
# Quark MXFP4 checkpoint, then replace WEIGHT_QUANTIZATION above with `auto`
# and uncomment both switches. The MTP/DFlash choice below remains independent.
# WEIGHT_QUANTIZATION=auto
# RADIANCE_MXFP4=1
# RADIANCE_MXFP4_W4A8=1
# RADIANCE_MXFP4_W4A8_MIN_M=0
# RADIANCE_MXFP4_DECODE_MAX_M=64
# RADIANCE_MXFP4_TN4_MIN_M=2048
# The decode kernel can cover M<=128 for a 16-request DFlash batch. This
# allocates 64 MiB of split-K scratch per rank instead of the 32 MiB M<=64
# default; enable it only with MAX_NUM_SEQS above 8.
# RADIANCE_MXFP4_DECODE_MAX_M=128
# Fragment-order weights remain an optional decode-priority tradeoff: they
# improve decode while mildly reducing prefill throughput.
# RADIANCE_MXFP4_WPERM=1
# Experimental RX4 decode tier for this exact Quark MXFP4 W4A8 TP2 lane. It
# failed this fork's strict output/tool qualification and is not a production
# recommendation. The aggregate
# switch enables both traced-quant legs and the required compiler passes;
# FP8_STREAM then fuses TP2 all-reduce with the residual/RMSNorm/quant
# epilogue. They receive isolated persistent graph-cache namespaces.
# RADIANCE_NORMQUANT_FUSION=1
# RADIANCE_FP8_STREAM=1
# The AMD checkpoint's embedded MTP tensors are BF16. Uncomment this only when
# selecting its MTP speculative profile; non-spec and DFlash do not need it.
# RADIANCE_QUARK_BF16_MTP=1

# Choose exactly one block: MTP or DFlash2. Leave both blocks commented for the
# correctness-qualified non-spec default. When switching modes, remove/comment
# every variable from the old block instead of combining the two profiles.

# Optional Qwen in-checkpoint MTP with R4D draft attention. Uncomment both for
# the measured fast-MTP path; num_speculative_tokens is a ceiling under dynamic
# drafting.
# RADIANCE_SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":8,"attention_backend":"R4D","disable_padded_drafter_batch":true}'
# RADIANCE_FAST_DRAFT=1
# RADIANCE_DRAFT_RERANK=64
# The target verify-head optimization is sampling-aware and automatically
# falls back for grammar-constrained, logprobs, min-p, and unsafe top-k steps.
# RADIANCE_VERIFY_HEAD=1
# Dynamic verification retains K7 for high-acceptance code/JSON and narrows
# lower-acceptance requests only once at least three requests are running.
# RADIANCE_DYNAMIC_WIDTH=1
# RADIANCE_DYNW_MIN_BATCH=5

# Alternative experimental DFlash2/V2 profile. Do not combine this with the MTP
# block above. Download magiccodingman/Qwen3.8-27B-heretic-ara-DFlash2-fp8
# beneath MODELS; the drafter path below is inside that mount. Change the active
# MAX_MODEL_LEN above to 8192. This reproduces the measured dual-R9700 K7 lane;
# strict cross-mode equivalence is not qualified. Public Compose keeps prefix
# caching enabled with hybrid-GDN align state for deployment. The two overrides
# below are benchmark-reproduction controls only: uncomment them when you need
# cold, nonce-disjoint BetterBench behavior or are deliberately testing the
# largest context envelope.
# PREFIX_CACHING_FLAG=--no-enable-prefix-caching
# MAMBA_CACHE_MODE=none
# VLLM_USE_V2_MODEL_RUNNER=1
# RADIANCE_COMPILATION_CONFIG='{"cudagraph_mode":"PIECEWISE"}'
# RADIANCE_FAST_DRAFT=1
# RADIANCE_SPECULATIVE_CONFIG='{"method":"dflash","model":"/models/Qwen3.8-27B-heretic-ara-DFlash2-fp8-magiccodingman","num_speculative_tokens":7,"draft_tensor_parallel_size":2,"attention_backend":"TRITON_ATTN","max_model_len":8192,"disable_padded_drafter_batch":true}'
# Experimental selector-width override. Leave unset/0 for the checkpoint's
# trained selector_top_k; if raised, DRAFT_RERANK must cover at least 4x it.
# RADIANCE_DFLASH_SELECTOR_TOPK=32
# For amd/Qwen3.8-27B-Quark-AWQ-MXFP4, use the target-matched
# tcclaviger/Qwen3.8-27B-DFlash2-FP8 path in the same JSON instead.
# In 0.9.3, FAST_DRAFT also accelerates DFlash by runtime-quantizing eligible
# draft linears to W4 and replacing the LM head with INT2 plus exact reranking.
# Its vLLM/Inductor graph caches are isolated from the ordinary draft lane.

# Experimental long-context prefill path. Value 3 enables both FP8 QK and PV
# attention legs. It is deliberately not the generic default because it changes
# kernel-level attention numerics and must be qualified for each model family.
# R4D_ATTN_FP8=3
