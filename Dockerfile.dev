# syntax=docker/dockerfile:1.7
# Fast iteration image. It reuses the last qualified fork image's ROCm 7.14,
# AMD PyTorch 2.12, Triton 3.7.1, AITER 0.1.20, and libr4d runtime, replaces
# only vLLM at an exact commit, then reapplies the audited Radiance modules and
# patches. Dockerfile remains the clean full-source release build; this overlay
# is for short compile/fix/benchmark cycles and is itself digest-pinned.
ARG BASE_IMAGE=magiccodingman/vllm-radiance@sha256:c8e0bd43c040846eb765f4d2cd03802634150154fd6118e7012d51bdf62fe501
ARG ROCM_BUILD_BASE=rocm/dev-ubuntu-24.04:7.14.0-full@sha256:439edaa8f0c4be4a3728e528f87b8a2ea1f051f34cf10b27caa4bd94f562eda7
ARG VLLM_COMMIT=2cf0a6915ce544dc493a0990f2ea38d81601128a
ARG VLLM_VERSION=0.28.0
ARG TRANSFORMERS_VERSION=5.15.0
ARG XGRAMMAR_VERSION=0.2.3
ARG R4D_VERSION=v0.5.0
ARG R4D_COMMIT=e8de4bc1f3dbd608dcb8d3ffceb6b48acdf83bb7

FROM ${ROCM_BUILD_BASE} AS rocm-build-files

FROM ${BASE_IMAGE} AS vllm-builder
ARG VLLM_COMMIT
ARG VLLM_VERSION
USER root
# Release images deliberately omit link-time-only archives. vLLM's ROCm
# extension still links rocSHMEM while building, so restore only that archive
# from the matching full, digest-pinned ROCm base in this throwaway stage.
COPY --from=rocm-build-files /opt/rocm/core-7.14/lib/librocshmem.a /opt/rocm/core-7.14/lib/librocshmem.a
RUN apt-get update && apt-get install -y --no-install-recommends \
      git build-essential ccache cmake ninja-build pkg-config cargo rustc \
    && rm -rf /var/lib/apt/lists/*
RUN pip install -U pip wheel "setuptools>=77,<80" "setuptools-scm>=8" \
      "setuptools-rust>=1.9" ninja cmake pybind11
RUN --mount=type=cache,id=radiance-dev-ccache-gfx1201,target=/root/.cache/ccache \
    git clone --filter=blob:none --no-checkout https://github.com/vllm-project/vllm.git /src/vllm \
    && cd /src/vllm \
    && git checkout --detach ${VLLM_COMMIT} \
    && test "$(git rev-parse HEAD)" = "${VLLM_COMMIT}" \
    && python use_existing_torch.py \
    && mkdir -p /wheels \
    && VLLM_TARGET_DEVICE=rocm VLLM_VERSION_OVERRIDE=${VLLM_VERSION} \
       MAX_JOBS=2 CMAKE_BUILD_PARALLEL_LEVEL=2 \
       pip wheel --no-build-isolation --no-deps . -w /wheels

FROM ${BASE_IMAGE} AS final
ARG VLLM_VERSION
ARG TRANSFORMERS_VERSION
ARG XGRAMMAR_VERSION
ARG R4D_VERSION
ARG R4D_COMMIT
ARG RADIANCE_VERSION=0.9.3-dev.vllm0.28.0-r4d0.5.0-mxfp4.rx4.dflash2.xgrammar
ENV RADIANCE_VERSION=${RADIANCE_VERSION} \
    RADIANCE_GDN_MERGE_INPROJ=1 RADIANCE_GDN_FUSED_UPDATE=1 RADIANCE_GDN_SHARED_BUILD=1 \
    RADIANCE_TOPK_COMPOSITE=1 RADIANCE_TOPK_COMPOSITE_KCAP=64 \
    RADIANCE_MXFP4_EPIFAST=1 RADIANCE_MXFP4_WPERM=0 RADIANCE_NORMQUANT_FUSION=0 \
    RADIANCE_MXFP4_HOIST_QUANT=0 RADIANCE_MXFP4_TRACED_QUANT=0 RADIANCE_FP8_STREAM=0 \
    RADIANCE_KV_GROUP_OPT=1 RADIANCE_AR_QNT=1024 RADIANCE_AR_QNB=96 \
    RADIANCE_DYNAMIC_WIDTH=1 RADIANCE_DYNW_MIN_BATCH=5 \
    RADIANCE_DRAFT_RERANK=64 RADIANCE_VERIFY_HEAD=1 R4D_ATTN_FP8=0

COPY --from=vllm-builder /wheels/vllm-*.whl /tmp/wheels/
RUN pip install --no-cache-dir /tmp/wheels/vllm-*.whl \
      "transformers==${TRANSFORMERS_VERSION}" "xgrammar==${XGRAMMAR_VERSION}" \
    && rm -rf /tmp/wheels /root/.cache

ENV SP=/opt/vllm/lib/python3.12/site-packages
COPY radiance_amdsmi.py radiance_amdsmi.pth \
     radiance_kernels.py radiance_vit_attn.py radiance_allreduce.py \
     radiance_draft.py radiance_draft_gpu.py radiance_drafthead.py radiance_gemm.py radiance_w4.py \
     radiance_r4d_attn.py radiance_gdn.py radiance_gdnmerge.py radiance_mxfp4.py \
     radiance_arnq.py radiance_topk.py radiance_verifyhead.py ${SP}/
COPY fp8-configs/ ${SP}/vllm/model_executor/layers/quantization/utils/configs/
COPY moe-configs/ ${SP}/vllm/model_executor/layers/fused_moe/configs/
COPY mxfp4-configs/ ${SP}/aiter/ops/triton/configs/gemm/
COPY patch_*.py install_radiance_hooks.py _patchlib.py /opt/patches/
RUN set -eu; cd /opt/patches; \
    for p in patch_gfx1201 patch_radiance_dispatch patch_skinny_gemm patch_unified_attention_lds \
             patch_gdn_wmma patch_gdn_aiter_prefill patch_preshuffle install_radiance_hooks \
             patch_unpad patch_mtp_mm_mask patch_mtp_loopbreak patch_qwen3_toolparse patch_from_json_filter \
             patch_dynamo_metrics patch_conv1d_blockn patch_r4d patch_dflash_base \
             patch_dflash_fused_kv_fp8 patch_dflash_logits_cache_stride patch_dflash_w4 \
             patch_dflash_selector_topk patch_gdn_metadata patch_gdn_shared_build \
             patch_topk_triton_rows patch_topk_composite patch_rocm_cudagraph_current_stream \
             patch_quark_mxfp4 patch_quark_bf16_mtp patch_ar_maxbytes patch_ar_geometry \
             patch_kv_group_size patch_gdn_merge_inproj patch_dynwidth patch_verify_head \
             patch_xgrammar_spec_termination \
             patch_xgrammar_spec_reasoning patch_parser_shared_engine; do \
      echo "== applying $p =="; python "$p.py"; \
    done; \
    python -c "import ast,glob; [ast.parse(open(f).read()) for f in glob.glob('${SP}/radiance_*.py')]"

COPY r4d_radiance_extras.patch /opt/patches/
RUN apt-get update \
 && apt-get install -y --no-install-recommends patch \
 && mkdir -p /tmp/libr4d \
 && curl -fsSL "https://codeberg.org/StillDeadcode/libr4d/archive/${R4D_COMMIT}.tar.gz" \
      | tar -xzf - -C /tmp/libr4d --strip-components=1 \
 && cd /tmp/libr4d \
 && patch --dry-run -p1 < /opt/patches/r4d_radiance_extras.patch \
 && patch -p1 < /opt/patches/r4d_radiance_extras.patch \
 && GFX_ARCH=gfx1201 OUT=${SP}/r4d.so ./build.sh \
 && WANT=$(echo "${R4D_VERSION}" | sed 's/^v//') \
 && python -c "import sys, torch, r4d; assert r4d.__version__ == sys.argv[1]; assert hasattr(r4d, 'ar_oneshot_2rank_exact_nq')" "$WANT" \
 && cd / \
 && rm -rf /tmp/libr4d \
 && apt-get purge -y patch \
 && rm -rf /var/lib/apt/lists/*

COPY radiance_mxfp4_fp8.hip /opt/patches/
RUN INC=$(python -m pybind11 --includes); \
    hipcc -O3 -std=c++17 -fPIC -shared --offload-arch=gfx1201 -Wno-unused-result \
      $INC /opt/patches/radiance_mxfp4_fp8.hip -o ${SP}/radiance_mxfp4_fp8.so \
 && python -c "import torch, radiance_mxfp4_fp8 as m; assert all(hasattr(m, n) for n in ('launch', 'set_decode_scratch', 'launch_add_rms_quant', 'launch_silu_mul_quant')); import radiance_mxfp4; assert hasattr(torch.ops.radiance, 'mxfp4_linear_pq')"

COPY radiance_preamble.py /opt/radiance_preamble.py
COPY radiance_entrypoint.sh /opt/radiance_entrypoint.sh
COPY VERSION /opt/radiance_version
RUN chmod +x /opt/radiance_entrypoint.sh \
    && WANT_VLLM=${VLLM_VERSION} python -c 'import os, importlib.metadata as m, vllm._C; \
v=m.version("vllm"); assert v.startswith(os.environ["WANT_VLLM"]), (v, os.environ["WANT_VLLM"]); print("vLLM overlay OK", v)' \
    && pip check
ENTRYPOINT ["/opt/radiance_entrypoint.sh"]
