# syntax=docker/dockerfile:1.7
# Fast Python/source-patch overlay for an already-built Radiance stack.
#
# Use this after changing guarded patches, hooks, configs, or the entrypoint. It
# intentionally does not rebuild torch, Triton, AITER, vLLM, or the existing HIP
# extensions, so compiler-stack checkpoints remain immutable and cheap to test.
ARG BASE_IMAGE=vllm-radiance:dev
FROM ${BASE_IMAGE}

USER root
ARG RADIANCE_VERSION=0.7.5-dev.vllm0.27.1-r4d0.4.0
ARG R4D_VERSION=v0.4.0
ARG R4D_COMMIT=000d5f91d0e47ee9faf3b5466f0a12995f0cbfd6
ENV RADIANCE_VERSION=${RADIANCE_VERSION} \
    SP=/opt/vllm/lib/python3.12/site-packages

COPY radiance_amdsmi.py radiance_amdsmi.pth \
     radiance_kernels.py radiance_vit_attn.py radiance_allreduce.py \
     radiance_draft.py radiance_draft_gpu.py radiance_drafthead.py radiance_router.py \
     radiance_r4d_attn.py radiance_gdn.py ${SP}/
COPY fp8-configs/ ${SP}/vllm/model_executor/layers/quantization/utils/configs/
COPY moe-configs/ ${SP}/vllm/model_executor/layers/fused_moe/configs/
COPY patch_*.py install_radiance_hooks.py _patchlib.py /opt/patches/

RUN set -eu; cd /opt/patches; \
    for p in patch_gfx1201 patch_radiance_dispatch patch_router_gemm patch_unified_attention_lds \
             patch_gdn_wmma patch_gdn_aiter_prefill patch_preshuffle install_radiance_hooks \
             patch_unpad patch_mtp_mm_mask patch_mtp_loopbreak patch_qwen3_toolparse patch_from_json_filter \
             patch_dynamo_metrics patch_conv1d_blockn patch_r4d; do \
      echo "== applying $p =="; python "$p.py"; \
    done; \
    python -c "import ast,glob; [ast.parse(open(f).read()) for f in glob.glob('${SP}/radiance_*.py')]; print('patch overlay parse OK')"; \
    python -c 'import importlib.metadata as m, torch, vllm._C; print("patch overlay stack OK", m.version("vllm"), torch.__version__, m.version("triton"), m.version("amd-aiter"))'

# Build the immutable libr4d source archive with the exact hipcc/pybind11 stack
# already present in the base image. The tag is checked against the extension's
# reported version after build.
RUN mkdir -p /tmp/libr4d \
 && curl -fsSL "https://codeberg.org/StillDeadcode/libr4d/archive/${R4D_COMMIT}.tar.gz" \
      | tar -xzf - -C /tmp/libr4d --strip-components=1 \
 && cd /tmp/libr4d \
 && GFX_ARCH=gfx1201 OUT=${SP}/r4d.so ./build.sh \
 && WANT=$(echo "${R4D_VERSION}" | sed 's/^v//') \
 && python -c "import sys, torch, r4d; assert r4d.__version__ == sys.argv[1]; print('r4d', r4d.__version__, 'kernels', len(r4d.kernels()))" "$WANT" \
 && rm -rf /tmp/libr4d

COPY VERSION /opt/radiance_version
COPY radiance_preamble.py /opt/radiance_preamble.py
COPY radiance_entrypoint.sh /opt/radiance_entrypoint.sh
RUN chmod +x /opt/radiance_entrypoint.sh
ENTRYPOINT ["/opt/radiance_entrypoint.sh"]
