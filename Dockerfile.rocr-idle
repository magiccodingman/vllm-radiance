# Explicit experimental image. The standard Dockerfile and runtime defaults do not use this.
# Supply an immutable Radiance image: --build-arg RADIANCE_IMAGE=<name>@sha256:<digest>
ARG RADIANCE_IMAGE
FROM rocm/dev-ubuntu-24.04:7.14.0-full@sha256:439edaa8f0c4be4a3728e528f87b8a2ea1f051f34cf10b27caa4bd94f562eda7 AS rocr-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake ninja-build git python3 libelf-dev libdrm-dev libnuma-dev pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY backports/rocr-idle /review/backports/rocr-idle
COPY tools/rocr_idle_backport.py /review/tools/rocr_idle_backport.py
RUN python3 /review/tools/rocr_idle_backport.py prepare /rocr-source \
    && python3 /review/tools/rocr_idle_backport.py build /rocr-source /rocr-build /candidate

FROM ${RADIANCE_IMAGE}
ARG RADIANCE_IMAGE
COPY backports/rocr-idle /opt/radiance-rocr-idle/backports/rocr-idle
COPY tools/rocr_idle_backport.py /opt/radiance-rocr-idle/tools/rocr_idle_backport.py
# Refuse an unaudited/mutable base or a different original runtime before copying anything.
RUN python3 -c 'import os,re; assert re.fullmatch(r"[^\s@]+@sha256:[0-9a-f]{64}", os.environ["RADIANCE_IMAGE"]), "RADIANCE_IMAGE must be digest-pinned"' \
    && python3 /opt/radiance-rocr-idle/tools/rocr_idle_backport.py check-runtime /opt/rocm/core-7.14/lib/libhsa-runtime64.so.1.21.0
COPY --from=rocr-builder /candidate/libhsa-runtime64.so.1.21.0 /opt/rocm/core-7.14/lib/libhsa-runtime64.so.1.21.0
COPY --from=rocr-builder /candidate/provenance.json /opt/radiance-rocr-idle/provenance.json
RUN python3 /opt/radiance-rocr-idle/tools/rocr_idle_backport.py load-candidate /opt/rocm/core-7.14/lib/libhsa-runtime64.so.1.21.0
LABEL radiance.rocr-idle.status="experimental-r9700-unqualified"
